---
import BaseLayout from '../layouts/BaseLayout.astro';

const APP_URL = import.meta.env.VITE_APP_URL || 'https://app.pizomoney.behzaaad.ir';
---

<style>
  :root {
    --ink: #0f172a;
    --muted: #64748b;
    --line: #e2e8f0;
    --accent: #d97706;
    --accent-hover: #b45309;
    --bg: #f8fafc;
    --card: #ffffff;
    --radius: 1rem;
    --shadow: 0 10px 30px -10px rgba(2, 6, 23, 0.08);
    --radius-lg: 1.5rem;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Vazirmatn', system-ui, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.7;
    direction: rtl;
  }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, h4 { font-weight: 800; line-height: 1.25; letter-spacing: -0.02em; }
  p { color: var(--muted); }

  /* ---------- Navbar ---------- */
  header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-wrap {
    max-width: 1000px; margin: 0 auto; padding: 0 1.25rem;
    display: flex; align-items: center; justify-content: space-between; height: 3.5rem;
  }
  .logo {
    font-size: 1.25rem; font-weight: 900; color: var(--accent);
    display: flex; align-items: center; gap: 0.5rem;
  }
  .logo-mark {
    width: 32px; height: 32px; border-radius: 8px; background: transparent;
  }
  nav { display: flex; align-items: center; gap: 1.25rem; }
  nav a { font-size: 0.9rem; font-weight: 600; color: var(--muted); padding: 0.4rem 0.6rem; border-radius: 0.5rem; }
  nav a:hover { color: var(--accent); background: #fef3c7; }
  .nav-cta {
    padding: 0.55rem 1.2rem; background: var(--accent); color: #fff;
    font-weight: 700; border-radius: 0.6rem; font-size: 0.9rem;
  }
  .nav-cta:hover { background: var(--accent-hover); }

  /* ---------- Hero ---------- */
  .hero {
    max-width: 960px; margin: 0 auto 4rem; padding: 3rem 1.25rem;
    text-align: center;
    background: linear-gradient(135deg, #fef3c7 0%, #fdde96 55%, #fef3c7 100%);
    border-radius: var(--radius-lg);
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; inset: -10%;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="1" fill="%23d97706" opacity="0.12"/></svg>') repeat;
    opacity: 0.6; pointer-events: none;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 1.25rem;
    padding: 0.4rem 1rem; background: #fff; border: 1px solid var(--line);
    border-radius: 2rem; font-size: 0.8rem; font-weight: 700; color: #475569; box-shadow: var(--shadow);
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem); color: var(--ink); margin-bottom: 1.25rem;
    letter-spacing: -0.03em;
  }
  .hero h1 .accent { color: var(--accent); }
  .hero p {
    font-size: clamp(1rem, 2vw, 1.25rem); max-width: 640px; margin: 0 auto 1.75rem;
    color: var(--muted); line-height: 1.8;
  }
  .hero-actions {
    display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap;
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.85rem 1.5rem; border-radius: 0.7rem; font-weight: 700; font-size: 1rem;
    transition: transform 0.18s, box-shadow 0.18s, background 0.18s; cursor: pointer;
    border: none;
  }
  .btn-primary { background: var(--accent); color: #fff; box-shadow: 0 4px 12px -2px rgba(217, 119, 6, 0.35); }
  .btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 8px 20px -4px rgba(217, 119, 6, 0.45); }
  .btn-outline { background: #fff; color: var(--ink); border: 1px solid var(--line); }
  .btn-outline:hover { background: #f1f5f9; border-color: var(--muted); }
  .btn svg { width: 1.2rem; height: 1.2rem; }

  /* ---------- Section header ---------- */
  .section-head { text-align: center; max-width: 720px; margin: 0 auto 3rem; }
  .section-head .kicker {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.9rem;
    background: #fef3c7; color: #92400e; border-radius: 2rem; font-size: 0.8rem; font-weight: 800; margin-bottom: 0.75rem;
  }
  .section-head h2 { font-size: clamp(1.5rem, 3vw, 2rem); color: var(--ink); margin-bottom: 0.75rem; }
  .section-head p { font-size: 1.05rem; max-width: 560px; margin: 0 auto; }

  /* ---------- Features grid ---------- */
  .features-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem; padding: 0 1.25rem; max-width: 1100px; margin: 0 auto 5rem;
  }
  .feature-card {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.75rem; box-shadow: var(--shadow); transition: transform 0.2s, border-color 0.2s;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .feature-card:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: 0 20px 40px -12px rgba(2, 6, 23, 0.12); }
  .feature-icon {
    width: 3rem; height: 3rem; border-radius: 0.9rem; background: #fef3c7;
    color: #92400e; display: grid; place-items: center; flex-shrink: 0;
  }
  .feature-icon svg { width: 1.5rem; height: 1.5rem; }
  .feature-card h3 { font-size: 1.1rem; color: var(--ink); margin-bottom: 0.25rem; }
  .feature-card p { font-size: 0.92rem; color: var(--muted); line-height: 1.65; margin-bottom: 0.25rem; }

  /* ---------- Steps ---------- */
  .steps { padding: 0 1.25rem; max-width: 1100px; margin: 0 auto 5rem; }
  .steps-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;
  }
  .step {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.75rem; position: relative; overflow: hidden;
  }
  .step-num {
    position: absolute; top: 1.2rem; left: 1.2rem;
    font-size: 0.8rem; font-weight: 900; color: #cbd5e1; letter-spacing: 0.05em;
  }
  .step-content { padding-left: 2.5rem; }
  .step h3 { font-size: 1.1rem; color: var(--ink); margin-bottom: 0.5rem; }
  .step p { font-size: 0.92rem; color: var(--muted); line-height: 1.6; }

  /* ---------- Trust / CTA ---------- */
  .trust { padding: 0 1.25rem; max-width: 1100px; margin: 0 auto 5rem; }
  .trust-list {
    display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;
    list-style: none; padding: 1.5rem 0;
  }
  .trust-item {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.6rem 1rem; background: var(--card); border: 1px solid var(--line);
    border-radius: 0.7rem; font-size: 0.85rem; font-weight: 600; color: var(--muted);
    box-shadow: var(--shadow);
  }
  .trust-item svg { width: 1.1rem; height: 1.1rem; color: var(--accent); }

  .cta-block {
    max-width: 860px; margin: 0 auto 0; padding: 4rem 1.25rem; text-align: center;
    background: var(--ink); color: #fff; border-radius: var(--radius-lg);
    position: relative; overflow: hidden;
  }
  .cta-block::before {
    content: ''; position: absolute; inset: -50% -100% -50% 10%;
    background: linear-gradient(135deg, rgba(217,119,6,0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  .cta-block h2 { font-size: clamp(1.5rem, 3vw, 2rem); color: #fff; margin-bottom: 0.75rem; position: relative; z-index: 1; }
  .cta-block p { color: #cbd5e1; margin-bottom: 1.75rem; font-size: 1.05rem; position: relative; z-index: 1; }
  .cta-block .btn { margin-right: 0.6rem; }
  .cta-block .btn-outline { background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.35); }

  /* ---------- Footer ---------- */
  footer {
    border-top: 1px solid var(--line); background: var(--card);
    padding: 3rem 1.25rem; margin-top: 0;
  }
  .footer-wrap { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; align-items: center; text-align: center; }
  .footer-brand { font-size: 1.25rem; font-weight: 900; color: var(--accent); display: flex; align-items: center; gap: 0.5rem; }
  .footer-links { display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center; }
  .footer-links a { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  .footer-links a:hover { color: var(--accent); }
  .footer-copy { font-size: 0.8rem; color: var(--muted); margin-top: 0.5rem; }

  /* ---------- Responsive ---------- */
  @media (max-width: 640px) {
    .nav-wrap { height: auto; padding: 1rem 1rem; flex-direction: column; gap: 0.75rem; }
    nav { gap: 0.8rem; font-size: 0.85rem; }
    .hero-actions { flex-direction: column; align-items: center; width: 100%; }
    .hero-actions .btn { width: 100%; max-width: 320px; }
    .steps-grid { grid-template-columns: 1fr; }
  }
</style>

<BaseLayout>
  <header>
    <div class="nav-wrap">
      <div class="logo">
        <img src="/logo.png" alt="" class="logo-mark" aria-hidden="true">
        <span>Pizomoney</span>
      </div>
      <nav>
        <a href={APP_URL}>داشبورد</a>
        <a href="#features">ویژگی‌ها</a>
        <a href="#how-it-works">نحوه کار</a>
      </nav>
      <a href={APP_URL} class="nav-cta">شروع کنید</a>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <div class="hero-badge">کلاینت‌سايد · رایگان · بدون بک‌اند</div>
      <h1>مدیریت قرض‌ها و اقساط <span class="accent">با اطمینان</span></h1>
      <p>پلتفرم رایگان و متمرکز بر کاربر برای ثبت وام‌ها، پیگیری اقساط ماهانه، بکاپ گوگل درایو و داشبورد مالی شخصی. کلاً در مرورگر شما اجرا می‌شود — هیچ داده‌ای خارج از دستگاه شما نمی‌رود.</p>
      <div class="hero-actions">
        <a href={APP_URL} class="btn btn-primary">رفتن به برنامه <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="#features" class="btn btn-outline">معرفی ویژگی‌ها</a>
      </div>
    </section>

    <section id="features">
      <div class="section-head">
        <span class="kicker">وقتی قرض را کنترل کنید</span>
        <h2>ویژگی‌های اصلی Pizomoney</h2>
        <p>کلیه ابزارهایی که برای مدیریت بده‌ها و برنامه‌ریزی مالی لازم است، در یک برنامه یک صفحه‌ای.</p>
      </div>
      <div class="features-grid">
        <article class="feature-card">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
          <h3>مدیریت قرض‌ها و اقساط</h3>
          <p>کلیه بده‌ها و وام‌های ماهانه را ثبت کنید، تاریخ شروع و تعداد اقساط را مشخص کنید و پیش‌پرداختی‌ها را دنبال کنید.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
          <h3>تاریخ جلالی (شمسی)</h3>
          <p>همه محاسبات و تقویم با تاریخ جلالی اجرا می‌شوند؛ ماه‌های مختلف سال و سپری شدن به بعد سال پشتیبانی می‌شود.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg></div>
          <h3>بکاپ و بازیابی گوگل درایو</h3>
          <p>فایل بکاپ finance-backup.json را در درایوی شخصی خود ذخیره کنید و هر زمان بخواهید بازیابی کنید. فقط مجوز drive.file.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
          <h3>داشبورد و خلاصه مالی</h3>
          <p>جمع‌آوری همه اقساط فعال، محاسبه مجموع پرداختی و باقی‌مانده، و نمودار پیشرفت هر وام.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg></div>
          <h3>کلیه کلاینت‌سايد و رایگان</h3>
          <p>هیچ بک‌اند، دیتابیس یا سرور نیست؛ همه داده‌ها در localStorage مرورگر شما می‌مانند و هرگز خارج از دستگاه نمی‌رود.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg></div>
          <h3>تنظیمات و سفارشی‌سازی</h3>
          <p>زبان (فارسی / انگلیسی)، تم (تاریک / روشن) و واحد پول (تومان) را تنظیم کنید؛ تنظیمات ذخیره می‌شود.</p>
        </article>
      </div>
    </section>

    <section id="how-it-works" class="steps">
      <div class="section-head">
        <span class="kicker">سه قدم به کنترول مالی</span>
        <h2>نحوه کار Pizomoney</h2>
        <p>ثبت وام، علامت‌گذاری اقساط، و نظارت بر پیشرفت — همه در چند دقیقه.</p>
      </div>
      <div class="steps-grid">
        <article class="step">
          <span class="step-num">01</span>
          <div class="step-content">
            <h3>یک وام جدید اضافه کنید</h3>
            <p>نام وام، مبلغ کل، تعداد اقساط و ماه شروع را وارد کنید.</p>
          </div>
        </article>
        <article class="step">
          <span class="step-num">02</span>
          <div class="step-content">
            <h3>اقساط پرداخت شده را علامت بگذارید</h3>
            <p>هر ماه قسطی پرداخت کردید، آن را در لیست اقساط فعال علامت‌گذاری کنید.</p>
          </div>
        </article>
        <article class="step">
          <span class="step-num">03</span>
          <div class="step-content">
            <h3>پیشرفت را نظارت کنید</h3>
            <p>داشبورد مجموع قسط‌ها و باقی‌مانده هر وام را نمایش می‌دهد تا برنامه‌ریزی مالی شما شفاف باشد.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="trust">
      <ul class="trust-list">
        <li class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg> فایل بکاپ finance-backup.json</li>
        <li class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5"/></svg> تقویم جلالی کامل</li>
        <li class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5"/></svg> واحد پول تومان</li>
        <li class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg> ذخیره در localStorage</li>
      </ul>
    </section>

    <section class="cta-block">
      <h2>آماده‌ای برای شروع؟</h2>
      <p>داشبورد Pizomoney را باز کنید و اولین وام خود را ثبت کنید.</p>
      <div class="hero-actions" style="justify-content:center;">
        <a href={APP_URL} class="btn btn-primary">ورود به داشبورد <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-wrap">
      <div class="footer-brand"><img src="/logo.png" alt="" class="logo-mark" aria-hidden="true"><span>Pizomoney</span></div>
      <div class="footer-links">
        <a href={APP_URL}>داشبورد</a>
        <a href="#features">ویژگی‌ها</a>
        <a href="#how-it-works">نحوه کار</a>
        <a href="/privacy-policy">حفظ حریم خصوصی</a>
        <a href="/terms-of-service">قوانین استفاده</a>
      </div>
      <p class="footer-copy">&copy; 2026 Pizomoney. همه حقوق محفوظ.</p>
    </div>
  </footer>
</BaseLayout>
